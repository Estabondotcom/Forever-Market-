# Optional. Server only. Free key enables 30-day history after 2026-12-10.
AHLEDGER_API_KEY=

# Optional. Local/server only. Free Blizzard developer client for read-only verification.
# Never prefix these with NEXT_PUBLIC_ or commit .env.local.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Opt in only after verifying your client and reviewing the community house mapping.
BLIZZARD_COLLECTOR_ENABLED=false
BLIZZARD_HOUSE_ID=114
# Node-only hosting: the web app reads this path; Docker sets it automatically.
# BLIZZARD_HISTORY_PATH=/absolute/path/to/market-data/history.json
